<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>

    <Version>0.1.0</Version>
    <Authors>Luis Mañez</Authors>
    <Company>Acterion</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/luis-manez/agent-framework-extensions</RepositoryUrl>
    <PackageProjectUrl>https://github.com/luis-manez/agent-framework-extensions</PackageProjectUrl>

    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>