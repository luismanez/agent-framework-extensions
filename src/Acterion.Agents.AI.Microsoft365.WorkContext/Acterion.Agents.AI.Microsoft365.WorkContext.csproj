<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)/nuget/nuget-package.props" />

  <PropertyGroup>
    <Description>Host-independent Microsoft 365 work context client for .NET.</Description>
    <PackageId>Acterion.Agents.AI.Microsoft365.WorkContext</PackageId>
    <Title>Microsoft 365 Work Context</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial release with delegated Microsoft Graph work-context retrieval.</PackageReleaseNotes>
    <PackageTags>microsoft365;microsoft-graph;work-context;agents;ai;dotnet</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Acterion.Agents.AI.Microsoft365.WorkContext.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
  </ItemGroup>
</Project>